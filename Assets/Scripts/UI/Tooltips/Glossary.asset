  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b5956addaf8b40b5b94ed5db8820f70d, type: 3}
  m_Name: Glossary
  m_EditorClassIdentifier: Assembly-CSharp::Glossary
  statuses:
  - title: STRENGTH
    body: Adds {stacks} damage to every attack this character makes.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 1
  - title: DOUBLE ATTACK
    body: The next {stacks} attack this character makes deals double damage.
    terms:
    - Double Attack
    - Double Next Attack
    defaultStacks: 1
    defaultAmount: 1
    type: 2
  - title: POISON
    body: Deals {stacks} damage at the end of this character's turn, ignoring every
      defence.
    terms:
    - Poison
    - Poisoned
    defaultStacks: 3
    defaultAmount: 1
    type: 3
  - title: FROZEN
    body: Cannot act at all this turn - no cards, no attacks, no movement.
    terms:
    - Frozen
    - Freeze
    defaultStacks: 1
    defaultAmount: 1
    type: 4
  - title: SHIELD
    body: Absorbs the next {stacks} damage. Wiped at the start of every turn.
    terms: []
    defaultStacks: 5
    defaultAmount: 1
    type: 5
  - title: BLOCK
    body: Reduces each of the next {stacks} hits by {amount}.
    terms: []
    defaultStacks: 3
    defaultAmount: 5
    type: 6
  - title: PARRY
    body: Negates the damage for {stacks} hits and reflects the damage back to the
      attacker.
    terms: []
    defaultStacks: 2
    defaultAmount: 1
    type: 7
  - title: ROOTED
    body: Cannot move. Attacking and playing cards still work.
    terms:
    - Rooted
    - Root
    defaultStacks: 1
    defaultAmount: 1
    type: 8
  keywords:
  - title: INNATE
    body: Always in hand. Never enters the draw or discard pile.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 1
  - title: COOLDOWN
    body: Unusable for {magnitude} turns after it is played, and for {magnitude} turns
      from the start of the battle.
    terms: []
    defaultStacks: 2
    defaultAmount: 1
    type: 2
  termColor: {r: 1, g: 0.83, b: 0.48, a: 1}
