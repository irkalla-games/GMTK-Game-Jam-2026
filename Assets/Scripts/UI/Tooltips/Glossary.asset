  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b5956addaf8b40b5b94ed5db8820f70d, type: 3}
  m_Name: Glossary
  m_EditorClassIdentifier: Assembly-CSharp::Glossary
  statuses:
  - title: STRENGTH
    body: Adds 3 damage to the next {stacks} attacks.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 1
  - title: DOUBLE ATTACK
    body: The next {stacks} attack this character makes deals double damage.
    terms:
    - Double Attack
    - Double Next Attack
    defaultStacks: 1
    defaultAmount: 1
    type: 2
  - title: POISON
    body: Deals damage equal to {stacks} at the end of the turn.
    terms:
    - Poison
    - Poisoned
    defaultStacks: 1
    defaultAmount: 1
    type: 3
  - title: FROZEN
    body: Cannot act for {stacks} turns.
    terms:
    - Frozen
    - Freeze
    defaultStacks: 1
    defaultAmount: 1
    type: 4
  - title: SHIELD
    body: Absorbs the next {stacks} damage. Only lasts for this turn.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 5
  - title: BLOCK
    body: Reduces damage taken by 3 for {stacks} turns
    terms: []
    defaultStacks: 1
    defaultAmount: 5
    type: 6
  - title: PARRY
    body: Negates all damage and reflects the damage back for the next {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 7
  - title: ROOTED
    body: This character is unable to use move actions for {stacks} turns.
    terms:
    - Rooted
    - Root
    defaultStacks: 1
    defaultAmount: 1
    type: 8
  - title: DOUBLE SHIELD
    body: The next {stacks} Shields this character gains is doubled.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 9
  - title: DODGE
    body: Dodges the next attack and moves away. Lasts for the next {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 10
  - title: WEAKEN
    body: Reduces the damage dealt by this character for the next {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 11
  - title: TAUNT
    body: This character must move toward or attack the source of the Taunt for {stacks}
      turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 12
  - title: POISON BLADE
    body: For {stacks} more turns, every attack this character lands also applies
      {amount} Poison.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 14
  - title: STEALTH
    body: Enemies cannot target this character for {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 15
  - title: VULNERABLE
    body: Increase the damage taken by 3 for the next {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 3
    type: 16
  - title: EMPOWERED
    body: Increases that amount of stacks whenver {status} is applied to {targets}
      by {amount}.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 17
  - title: POTENT
    body: Increases the effect of {status} by {stacks}. (Does not effects stack amount)
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 18
  - title: STANDING WARD
    body: Applies {amount} {status} to all {targets} {timing}.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 19
  - title: SUMMONED
    body: Will die in {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 13
  - title: REGENERATION
    body: Heals {stacks} at the end of each of the carrier's turns, then decays by
      1.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 20
  - title: LIFESTEAL
    body: For {stacks} more of the carrier's turns, every hit it lands also heals
      it for half the damage dealt.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 21
  keywords:
  - title: INNATE
    body: Always in hand. Never enters the draw or discard pile.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 1
  - title: COOLDOWN
    body: Unusable for {magnitude} turns after it is played.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 2
  - title: DORMANT
    body: Unusable for {magnitude} turns after you gain it.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 3
