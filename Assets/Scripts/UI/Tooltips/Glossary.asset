  m_Script: {fileID: 11500000, guid: b5956addaf8b40b5b94ed5db8820f70d, type: 3}
  m_Name: Glossary
  m_EditorClassIdentifier: Assembly-CSharp::Glossary
  statuses:
  - title: STRENGTH
    body: Adds 3 damage to the next {stacks} attacks.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 1
  - title: DOUBLE ATTACK
    body: The next {stacks} attack this character makes deals double damage.
    terms:
    - Double Attack
    - Double Next Attack
    defaultStacks: 1
    defaultAmount: 1
    type: 2
  - title: POISON
    body: Deals damage equal to it's stacks ({stacks}) and the end of the turn and
      then loses a stack.
    terms:
    - Poison
    - Poisoned
    defaultStacks: 1
    defaultAmount: 1
    type: 3
  - title: FROZEN
    body: Cannot act for {stacks} more turns.
    terms:
    - Frozen
    - Freeze
    defaultStacks: 1
    defaultAmount: 1
    type: 4
  - title: SHIELD
    body: Absorbs the next {stacks} damage. Only lasts for this turn.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 5
  - title: BLOCK
    body: Reduces the damage this character takes by 3 for the next {stacks} hits.
    terms: []
    defaultStacks: 1
    defaultAmount: 5
    type: 6
  - title: PARRY
    body: Negates the damage for {stacks} hits and reflects the damage back to the
      attacker.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 7
  - title: ROOTED
    body: This character is unable to use move actions for {stacks} turns.
    terms:
    - Rooted
    - Root
    defaultStacks: 1
    defaultAmount: 1
    type: 8
  - title: DOUBLE SHIELD
    body: The next {stacks} Shield this character gains is doubled.
    terms:
    - Double Shield
    defaultStacks: 1
    defaultAmount: 1
    type: 9
  - title: DODGE
    body: Negates the damage for {stacks} hits and moves the character away from
      the source of damage.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 10
  - title: WEAKEN
    body: Subtracts 5 damage from each attack for {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 11
  - title: TAUNT
    body: This character must move toward or attack the source of the Taunt for {stacks}
      turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 12
  - title: POISON BLADE
    body: For {stacks} more turns, every attack this character lands also applies
      {amount} Poison.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 14
  - title: STEALTH
    body: Enemies cannot target this character for {stacks} more turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 15
  - title: VULNERABLE
    body: Adds 3 damage to each of the next {stacks} hits taken.
    terms: []
    defaultStacks: 1
    defaultAmount: 3
    type: 16
  - title: EMPOWERED
    body: Doubles the stacks of whatever status this totem empowers, whenever it
      is applied.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 17
  - title: POTENT
    body: Strengthens whatever status this totem empowers, without changing its stacks.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 18
  - title: STANDING WARD
    body: Grants a status to whoever stands in range, once every round.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 19
  keywords:
  - title: INNATE
    body: Always in hand. Never enters the draw or discard pile.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 1
  - title: COOLDOWN
    body: Unusable for {magnitude} turns after it is played.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 2
  - title: DORMANT
    body: Unusable for {magnitude} turns after you gain it.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 3
