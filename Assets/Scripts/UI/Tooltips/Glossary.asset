  m_Name: Glossary
  m_EditorClassIdentifier: Assembly-CSharp::Glossary
  statuses:
  - title: STRENGTH
    body: Adds 3 damage to the next {stacks} attacks.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 1
  - title: DOUBLE ATTACK
    body: The next {stacks} attack this character makes deals double damage.
    terms:
    - Double Attack
    - Double Next Attack
    defaultStacks: 1
    defaultAmount: 1
    type: 2
  - title: POISON
    body: Deals damage equal to {stacks} at the end of the turn.
    terms:
    - Poison
    - Poisoned
    defaultStacks: 1
    defaultAmount: 1
    type: 3
  - title: FROZEN
    body: Cannot act for {stacks} turns.
    terms:
    - Frozen
    - Freeze
    defaultStacks: 1
    defaultAmount: 1
    type: 4
  - title: SHIELD
    body: Absorbs the next {stacks} damage. Only lasts for this turn.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 5
  - title: BLOCK
    body: Reduces damage taken by 3 for {stacks} turns
    terms: []
    defaultStacks: 1
    defaultAmount: 5
    type: 6
  - title: PARRY
    body: Negates all damage and reflects the damage back for the next {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 7
  - title: ROOTED
    body: This character is unable to use move actions for {stacks} turns.
    terms:
    - Rooted
    - Root
    defaultStacks: 1
    defaultAmount: 1
    type: 8
  - title: DOUBLE SHIELD
    body: The next {stacks} Shields this character gains is doubled.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 9
  - title: DODGE
    body: Dodges the next attack and moves away. Lasts for the next {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 10
  - title: WEAKEN
    body: Reduces the damage dealt by this character for the next {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 11
  - title: TAUNT
    body: This character must move toward or attack the source of the Taunt for {stacks}
      turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 12
  - title: POISON BLADE
    body: For {stacks} more turns, every attack this character lands also applies
      {amount} Poison.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 14
  - title: STEALTH
    body: Enemies cannot target this character for {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 15
  - title: VULNERABLE
    body: Increase the damage taken by 3 for the next {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 3
    type: 16
  - title: EMPOWERED
    body: Multiplies {status} granted to all {targets} in range by {amount}.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 17
  - title: POTENT
    body: Adds {amount} to the potency of {status} for all {targets} in range.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 18
  - title: STANDING WARD
    body: Grants {amount} {status} to all {targets} in range {timing}.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 19
  - title: SUMMONED
    body: Will die in {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 13
  - title: REGENERATION
    body: Heals {stacks} at the end of each of the carrier's turns, then decays by
      1.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 20
  - title: LIFESTEAL
    body: For {stacks} more of the carrier's turns, every hit it lands also heals
      it for half the damage dealt.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 21
  - title: HONED
    body: All {targets} in range deal {amount} more damage.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 22
  - title: SHELTERED
    body: All {targets} in range take {amount} less damage.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 23
  - title: BOLSTERED
    body: Adds {amount} to {status} granted to all {targets} in range.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 24
  - title: WARDED
    body: Immune to one status at a time. Which one rotates at the end of each of this
      character's turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 25
  - title: THORNS
    body: Attackers take {stacks} damage whenever they hit this character. Does not
      wear off.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 26
  - title: SPLITTING
    body: Splits into two at half health, with the remaining health shared between
      them.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 27
  - title: ESCAPING
    body: Blinks to the far side of the board each time its health falls past another
      threshold.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 28
  - title: PILFERED
    body: Discards a card at random at the start of each of the next {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 29
  - title: SAPPED
    body: 1 less energy each turn for {stacks} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 30
  keywords:
  - title: INNATE
    body: Always in hand. Never enters the draw or discard pile.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 1
  - title: COOLDOWN
    body: Unusable for {magnitude} turns after it is played.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 2
  - title: DORMANT
    body: Unusable for {magnitude} turns after you gain it.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 3
  - title: INTERRUPTIBLE
    body: Freezing this character while it is winding this up knocks the card out for
      {magnitude} turns.
    terms: []
    defaultStacks: 1
    defaultAmount: 1
    type: 5
